{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fangviper-track",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public" },
  // Keeps request logs (webhooks, email job) in the Cloudflare dashboard under Workers > fangviper-track > Logs.
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "fangviper-track", "database_id": "bca55b70-0586-4b7a-87b8-abe718189db5" }
  ],
  // Every hour: send the "being made" email to orders that are 24h old.
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "SITE_URL": "https://track.drevaunt.com",
    "STORE_URL": "https://drevaunt.com",
    // Sent through Resend from the verified updates.drevaunt.com subdomain; replies go to MAIL_REPLY_TO.
    "MAIL_FROM": "Drevaunt <orders@updates.drevaunt.com>",
    "MAIL_REPLY_TO": "support@drevaunt.com",
    "EMAIL_DELAY_HOURS": "24",
    // A second email on this day if the order still has not shipped, pointing to that day's new step.
    "REMINDER_DAYS": "5"
  }
  // Secrets (set with `npx wrangler secret put NAME`, never in this file):
  //   SHOPIFY_WEBHOOK_SECRET  the signing key shown under Shopify > Settings > Notifications > Webhooks
  //   RESEND_API_KEY          from resend.com > API Keys
}
